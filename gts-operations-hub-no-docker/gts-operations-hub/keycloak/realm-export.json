{
  "realm": "gts",
  "enabled": true,
  "displayName": "GTS Operations Hub",
  "roles": {
    "realm": [
      {"name": "platform-admin"},
      {"name": "operator"},
      {"name": "viewer"}
    ]
  },
  "clients": [
    {
      "clientId": "gts-dashboard",
